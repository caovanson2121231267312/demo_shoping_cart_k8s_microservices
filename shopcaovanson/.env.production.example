# =============================================================================
# Production secrets — shopcaovanson K8s
# =============================================================================
# 1. Copy file này:  cp .env.production.example .env.production
# 2. Sửa giá trị bên dưới (hoặc để trống — script sẽ sinh ngẫu nhiên)
# 3. Chạy:           bash scripts/create-secrets.sh
#
# ⚠️  KHÔNG commit file .env.production vào git!
# =============================================================================

# --- Infra (namespace: infra) ---
POSTGRES_PASSWORD=
MONGO_PASSWORD=
REDIS_PASSWORD=
ELASTIC_PASSWORD=

# --- SMTP (notification-service) — để trống nếu chưa cần gửi email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@shopcaovanson.xyz
SMTP_USE_TLS=true

# --- GitHub Container Registry (tùy chọn — nếu image private) ---
GHCR_USERNAME=
GHCR_TOKEN=
GHCR_EMAIL=admin@shopcaovanson.xyz

# --- Domains (dùng build URL trong secret) ---
API_DOMAIN=vocabee.cloud
FRONTEND_DOMAIN=shopcaovanson.xyz

# --- PostgreSQL user (khớp với k8s/base/infra/postgres.yaml) ---
POSTGRES_USER=shopcaovanson
MONGO_USER=shopcaovanson
