PORT=8085

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDER_CREATED=order.created
KAFKA_TOPIC_USER_REGISTERED=user.registered
KAFKA_TOPIC_USER_VERIFICATION=user.verification_requested
KAFKA_TOPIC_PASSWORD_RESET=user.password_reset_requested
KAFKA_TOPIC_INVOICE=order.invoice.generate
KAFKA_GROUP_ORDER=notification-order
KAFKA_GROUP_USER=notification-user
KAFKA_GROUP_VERIFICATION=notification-verification
KAFKA_GROUP_PASSWORD_RESET=notification-password-reset
KAFKA_GROUP_INVOICE=notification-invoice

INVOICE_STORAGE_PATH=./data/invoices

# Mailtrap sandbox (https://mailtrap.io) — copy credentials vao .env
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@shopcaovanson.xyz

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_USE_TLS=true
SMTP_FROM=noreply@shopcaovanson.xyz
